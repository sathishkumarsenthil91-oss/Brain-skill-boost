# Public browser configuration. These values are safe to expose to the Vite client.
VITE_SUPABASE_URL=https://nzgisrrrbabedlntmcoc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key compatibility:
VITE_SUPABASE_ANON_KEY=

# Vercel/server runtime configuration for HttpOnly cookie sessions.
# These are the same PUBLIC Supabase project values; no service-role key is required.
SUPABASE_URL=https://nzgisrrrbabedlntmcoc.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Put these in Supabase Edge Function secrets for hosted AI APIs, never in VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Used only by the optional local Express server.
GEMINI_API_KEY=
